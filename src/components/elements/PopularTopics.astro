---
/**
 * PopularTopics — the right column of the /blog featured area, reproducing the
 * live `Popular Topics` block: a 21px/500 heading over a vertical list of tag
 * links (openmined.org/blog, verified 2026-07-01). Links go to the tag archive
 * `/blog/tag/<id>/` (URL parity with live).
 *
 * The list is small body (`.text-small`, 14px) rather than live's 16px, so the
 * rail reads as secondary to the featured panel beside it.
 *
 * The set is a curated editorial list (not "most-used"), so the caller passes
 * the resolved topics in order. Labels come from the `tags` collection so they
 * stay canonical.
 */
interface Topic {
  id: string;
  label: string;
}
interface Props {
  topics: Topic[];
  heading?: string;
}
const { topics, heading = 'Popular Topics' } = Astro.props;
---

<div class="popular-topics">
  <p class="popular-topics__heading">{heading}</p>
  <ul class="popular-topics__list text-small">
    {topics.map((t) => (
      <li><a href={`/blog/tag/${t.id}/`}>{t.label}</a></li>
    ))}
  </ul>
</div>

<style>
  .popular-topics__heading {
    margin: 0 0 var(--spacing-L);
    font-weight: 500;
    color: var(--text-headline);
    font-size: 21px;
  }
  .popular-topics__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-S);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .popular-topics__list a {
    color: var(--text-body);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .popular-topics__list a:hover { color: var(--text-headline); }
</style>
