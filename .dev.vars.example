# Local secrets for `astro dev` (read via the Cloudflare adapter's platformProxy).
# Copy to `.dev.vars` (gitignored) and fill in. LOCAL DEV ONLY — production
# reads the key from SSM Parameter Store; see aws/create-donation/README.md.
# Until it is set, /api/create-donation returns 503 and the donate modal shows
# a friendly "not available right now" message — the rest of the site is fine.

STRIPE_SECRET_KEY=sk_test_xxx
