---
/**
 * /research/grants/ — Research Grants: OpenMined's research grant program,
 * and the call that is currently open (Ensembles & Routing, Winter 2026).
 *
 * Built to outlast one call: a generic "Research Grants" hero, then the
 * current call beneath it, then a "future calls" sign-up. To run a new call,
 * replace everything from #current-call down to the call FAQ.
 *
 * One long reading page, deliberately: a sticky "On this page" index beside
 * a single measured reading column, headed sections in one flow.
 *
 * Copy source: the "Research Grants — page copy" Google Doc, as edited by
 * Lacey and Irina (10/2). It began as Irina's "Frontier Fellowship" draft
 * (OpenMined/screamingface-brand → brand-site/fellowship/, 9/30). Standing
 * rules from the Lacey ↔ Bennett 1:1 (9/30): no ScreamingFace naming on the
 * public page ("our toolkit"), and intake is a HubSpot form.
 *
 * ⚠ STAGING DRAFT — the `.tbd` chips mark copy still open in the doc. Every
 * one must be resolved (or cut) before this ships to production:
 *   1. "the first verified map of the quality–cost frontier…" (the problem)
 *   2. compute covered per grantee (what we provide + FAQ)
 *   3. the recipe format name, "url4" (what we provide) — and whether
 *      "Our toolkit" links anywhere (Lacey's open comment)
 *   4. hours per week (how to apply)
 *   5. the launch benchmarks (FAQ)
 * Also open: where applications route in HubSpot (both forms are embed-only).
 */
import Page from '@layouts/Page.astro';
import FormEmbed from '@elements/FormEmbed.astro';
import Button from '@ui/Button.astro';
import { SITE_URL } from '@data/site.mjs';

const tbd = (s: string) => `<span class="tbd" title="To be decided before launch">${s}</span>`;

const index = [
  { id: 'current-call', label: 'Current call' },
  { id: 'problem', label: 'The problem' },
  { id: 'aim', label: 'What this call seeks' },
  { id: 'provide', label: 'What we provide' },
  { id: 'who', label: 'Who it’s for' },
  { id: 'work', label: 'What you’d do' },
  { id: 'credit', label: 'Credit and IP' },
  { id: 'apply', label: 'How to apply' },
  { id: 'faq', label: 'FAQ' },
  { id: 'future', label: 'Future calls' },
];

const provisions = [
  { term: 'Compute', html: `Subsidized inference covering ${tbd('the costs of grant runs / up to $X per grantee')}, so an ensemble can use as many models as the idea needs.` },
  { term: 'Infrastructure', html: `Our toolkit is open source and runs locally, on your keys or ours. Any ensemble or router becomes a single ${tbd('url4')} recipe that can be rerun, shared, and published.` },
  { term: 'Engineering', html: 'Our engineers work directly with you to extend the toolkit around your method until it expresses the method faithfully.' },
  { term: 'Evaluation', html: 'Independent re-runs and full cost accounting, so your result stands on its own for anyone who reads it.' },
  { term: 'Stipend', html: '$2,000 stipend for your time.' },
];

const arc = [
  { term: 'Weeks 1–2', lead: 'Get set up.', text: 'Reproduce a known ensemble as your first submission, so you’ve proven the pipeline before the real work starts.' },
  { term: 'Weeks 3–6', lead: 'Run your method.', text: 'Rebuild it as an open recipe and measure it against current models and benchmarks.' },
  { term: 'Weeks 7–10', lead: 'Push.', text: 'Stronger models, better aggregation, a cheaper cascade, or a combination with another grantee’s recipe. This is where most frontier results come from.' },
  { term: 'Weeks 11–12', lead: 'Write it up.', text: 'Author review, a short technical note under your name, and the co-authored cohort paper.' },
];

const faqs = [
  { q: 'Do I need my own compute budget or API keys?', a: `No. Subsidized inference covers ${tbd('the costs of grant runs / up to $X per grantee')}. The toolkit runs on our keys or yours — whichever you prefer — so the cost of running an ensemble across many models is not your problem to solve.` },
  { q: 'What if my reimplementation doesn’t reproduce, or the method doesn’t transfer?', a: 'That’s a finding, and we will publish it with the same care as a new state of the art. A method that fails to transfer to current models tells the field something important. Nobody is penalized for an honest negative result, as the field needs a verified map of what has been tried, and the map needs to show which attempts lead to dead ends.' },
  { q: 'What models and benchmarks will we work against?', a: `Current frontier models, measured along the frontier of quality against cost and latency. The launch benchmarks are ${tbd('launch benchmarks')}, and every result is published with its full recipe and its full cost in tokens, dollars, and time so anyone can rerun it.` },
];
---

<Page
  title="Research Grants"
  description="OpenMined research grants give independent researchers the resources to pursue open questions at the intersection of privacy, open infrastructure, and data governance."
  socialDescription="We believe research can change how technology gets built. OpenMined research grants give independent researchers the resources to pursue a mutually defined piece of work."
  breadcrumbs={[
    { name: 'Home', item: `${SITE_URL}/` },
    { name: 'Research', item: `${SITE_URL}/research/` },
    { name: 'Research Grants' },
  ]}
>
  <div class="grants-progress" aria-hidden="true"><span></span></div>

  <header id="top" class="container grants-hero">
    <h1 data-fade>Research Grants</h1>
    <p class="grants-hero__statement" data-fade>We believe research can change how technology gets built.</p>
    <p class="grants-hero__lede measure" data-fade>OpenMined supports independent research on how data, privacy, and power are governed as technology becomes more capable. Our research grants give researchers the resources to pursue a mutually defined piece of work that advances our nonprofit mission.</p>
    <div class="grants-hero__cta" data-fade><Button href="#current-call">See the current call</Button></div>
  </header>

  <div class="container grants">
    <nav class="grants__index" aria-label="On this page">
      <p class="grants__index-label">On this page</p>
      <ol>
        {index.map((s) => <li><a href={`#${s.id}`} data-index-link={s.id}>{s.label}</a></li>)}
      </ol>
    </nav>

    <article class="grants__read">
      <section id="current-call" class="grants__section grants__section--open" data-index-section>
        <div class="call-head" data-reveal>
          <p class="call-head__label"><i aria-hidden="true"></i><span>Current call</span><span class="call-head__sep" aria-hidden="true">·</span><span>Applications close Oct 23, 2026</span></p>
          <h2 class="call-head__title">Ensembles &amp; Routing (Winter 2026)</h2>
        </div>
        <h2 data-reveal>Overview</h2>
        <p class="grants__lead" data-reveal>A 12-week grant for researchers who have worked on ensembles, routing, or model composition. We cover the compute and engineering to run your method on current frontier models, re-run every result independently, and publish the full recipe and cost so anyone can verify it.</p>
      </section>

      <section id="problem" class="grants__section" data-index-section>
        <h2 data-reveal>The problem</h2>
        <p data-reveal>More and more of what’s possible in AI now depends on how models are combined. There are dozens of capable models, each strong in different places, and prices for comparable quality span an order of magnitude or more.</p>
        <p data-reveal>Ensemble research saw this coming. Mixture-of-agents, generate-and-rank fusion, self-consistency, multi-agent debate, verifier-guided selection — again and again, a group of models did what no single one could. Routers and cascades proved it from the other side: send each query to the model that fits, and pay for the strongest only when you need it. If you’re reading this, some of that work is probably yours.</p>
        <p data-reveal>But nearly all of it ran under tight constraints — the models of the moment, whatever compute a lab could spare, an eval harness built for one paper. Ensembles are expensive by design: every query passes through several models, so testing one on today’s frontier means a real inference bill before you see a single result. Then you have to rebuild the evaluation and find a fair basis for comparison. So the strongest methods have mostly never run on the models where they’d matter most.</p>
        <p data-reveal>Our research grants take that wall down. We cover the compute, build the engineering, and run the evaluation — and we make every result credible to anyone who reads it. You bring the idea. We help you find out how far it goes.</p>
        <p data-reveal>The best quality reachable at each level of cost and latency, measured on current models — and put in the open, so it holds for everyone and not just for us.</p>
        <p data-reveal>Every result is re-run independently and published with its full recipe and its full cost, in tokens, dollars and time. Nothing rests on trust: anyone can verify a state-of-the-art mark by rerunning it. Together, the cohort’s work becomes a co-authored, openly published map — <Fragment set:html={tbd('the first verified map of the quality–cost frontier for ensembles and routers on current models')} /> — a commons that outlasts the cohort and belongs to the field.</p>
      </section>

      <section id="aim" class="grants__section" data-index-section>
        <h2 data-reveal>What this call seeks to accomplish</h2>
        <p data-reveal>Map the quality–cost frontier for ensembles and routers on current models, in the open. We believe the strongest AI systems will be ensembles of many models, and that the evidence for this is spread across papers that are never measured against each other. Ensembles and routers should be measured against current models, with quality, cost, and latency as key dimensions to test. We re-run every result independently and publish its full recipe and cost in tokens, dollars, and time.</p>
      </section>

      <section id="provide" class="grants__section" data-index-section>
        <h2 data-reveal>What we provide</h2>
        <dl class="provisions">
          {provisions.map((p, i) => (
            <div class="provisions__row" data-reveal data-reveal-delay={i * 70}>
              <dt>{p.term}</dt>
              <dd set:html={p.html} />
            </div>
          ))}
        </dl>
      </section>

      <section id="who" class="grants__section" data-index-section>
        <h2 data-reveal>Who’s this for</h2>
        <p data-reveal>Researchers with published work on ensembles, routing, multi-agent systems, model composition, or closely related areas, and people with a well-formed idea in the space and the rigor to test it. If you’ve built a mixture-of-agents system, a router, a cascade, a verifier, or a fusion method, please apply!</p>
      </section>

      <section id="work" class="grants__section" data-index-section>
        <h2 data-reveal>What you’d do</h2>
        <p data-reveal>You bring one method or idea, and over 12 weeks you take it from a first run to a published result. Pick a track: bring a published method back to life on today’s models, or test an idea nobody has tried. Either way, the work happens in the open, on a public leaderboard, where every entry is a recipe with its full cost.</p>
        <p data-reveal>The 12 weeks follow the same arc for everyone:</p>
        <dl class="provisions provisions--arc">
          {arc.map((w, i) => (
            <div class="provisions__row" data-reveal data-reveal-delay={i * 70}>
              <dt>{w.term}</dt>
              <dd><strong>{w.lead}</strong> {w.text}</dd>
            </div>
          ))}
        </dl>
        <p data-reveal><strong>Out of scope:</strong> anything that needs pretraining or fine-tuning large models, or that can’t run through the toolkit within 12 weeks. The work is zero-shot and composed from existing models: ensembles, routers, cascades, judges. If you’re set on a method the stack doesn’t support yet, tell us. We’d rather extend the toolkit than turn a good idea away.</p>
      </section>

      <section id="credit" class="grants__section" data-index-section>
        <h2 data-reveal>How credit and IP work</h2>
        <p data-reveal>Recipes, results, and code are open source. You keep authorship of your ideas and notes and share authorship of the cohort paper. When a grantee reimplements a published method, the original authors are invited to review the implementation before anything is published. Reimplementations are attributed to the original authors first and to the grantee second, and every entry links to the source paper.</p>
      </section>

      <section id="apply" class="grants__section" data-index-section>
        <h2 data-reveal>How to apply</h2>
        <p data-reveal>Grants are open to researchers with published work on ensembles, routing, multi-agent systems, model composition, or closely related areas. They are also open to people with a well-formed idea in this space and the rigor to test it. Nominations of others are highly encouraged and will be given additional consideration in applications.</p>
        <p data-reveal>We will put more weight on work you’ve shipped in this area (a paper, preprint, workshop paper, or competition write-up with code), and a specific proposal that names the method, the benchmark, and the models.</p>
        <div class="apply-card" data-reveal>
          <dl class="apply-card__meta">
            <div><dt>Applications close</dt><dd>Oct 23, 2026</dd></div>
            <div><dt>Offers</dt><dd>Rolling, all by Oct 27</dd></div>
            <div><dt>Grant program runs</dt><dd>Nov 1, 2026 – Jan 23, 2027</dd></div>
            <div><dt>Commitment</dt><dd>12 weeks · ~<Fragment set:html={tbd('X')} /> hrs/week</dd></div>
          </dl>
          <div class="apply-card__form">
            <FormEmbed formId="05a6c133-be9b-4927-b971-0d253d2ba5db" />
            <p class="apply-card__fine">Submitting confirms you agree with our <a href="/privacy-policy/">privacy policy</a>.</p>
          </div>
        </div>
      </section>

      <section id="faq" class="grants__section" data-index-section>
        <h2 data-reveal>Ensembles &amp; Routing (Winter 2026) FAQ</h2>
        <div class="faq" data-reveal>
          {faqs.map((f) => (
            <details>
              <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
              <div class="faq__a"><p set:html={f.a} /></div>
            </details>
          ))}
        </div>
      </section>

      <section id="future" class="grants__section" data-index-section>
        <h2 data-reveal>Hear about future calls</h2>
        <p data-reveal>Calls are announced here and through our community. Leave your details, and we’ll be in touch when one matches your work.</p>
        <div class="apply-card" data-reveal>
          <div class="apply-card__form apply-card__form--solo">
            <FormEmbed formId="57645870-171a-4f93-93a1-310665ae99ae" />
            <p class="apply-card__fine">Submitting confirms you agree with our <a href="/privacy-policy/">privacy policy</a>.</p>
          </div>
        </div>
      </section>
    </article>
  </div>
</Page>


<script>
  // Reading progress + "On this page" state. Progressive enhancement: without
  // JS the index is plain anchor links and the bar stays empty.
  const bar = document.querySelector<HTMLElement>('.grants-progress span');
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-index-link]').forEach((a) => links.set(a.dataset.indexLink!, a));
  const sections = [...document.querySelectorAll<HTMLElement>('[data-index-section]')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    const line = window.innerHeight * 0.35;
    let current = sections[0]?.id;
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
    links.forEach((a, id) => a.toggleAttribute('aria-current', id === current));
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };

  // Keep the sticky index clear of the header, which hides on scroll-down
  // and returns on scroll-up (Header.astro toggles [data-hidden]).
  const header = document.querySelector<HTMLElement>('[data-header]');
  const indexNav = document.querySelector<HTMLElement>('.grants__index');
  const syncIndex = () => {
    if (!header || !indexNav) return;
    const showing = !header.hasAttribute('data-hidden') && getComputedStyle(header).position !== 'static';
    indexNav.style.setProperty('--index-top', showing ? `${header.offsetHeight}px` : '0px');
  };
  if (header) new MutationObserver(syncIndex).observe(header, { attributes: true, attributeFilter: ['data-hidden'] });
  window.addEventListener('resize', syncIndex, { passive: true });
  syncIndex();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
</script>

<style>
  /* ── Reading progress: a hairline across the very top ───────────────── */
  .grants-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 1000;
    pointer-events: none;
  }
  .grants-progress span {
    display: block;
    height: 100%;
    background: var(--text-headline);
    opacity: 0.55;
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* ── Hero: centred title, statement, lede, one button ───────────────── */
  /* One column axis for the whole page: the hero, the rule under it and
     the reading column share --read-w and are centred on the page. */
  .grants-hero {
    --h1-max: 52px;
    max-width: var(--read-w);
    padding-block: var(--spacing-5XL) var(--spacing-4XL);
    text-align: center;
    border-bottom: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent);
    scroll-margin-top: var(--spacing-5XL);
  }
  .grants-hero,
  .grants { --read-w: 38rem; }
  .grants-hero h1 { margin: 0 0 var(--spacing-2XL); }
  /* The program's one-line belief, in headline ink, over the body-size lede. */
  .grants-hero__statement {
    margin: 0 0 var(--spacing-L);
    font-family: var(--font-secondary);
    font-size: 21px;
    line-height: 1.5;
    color: var(--text-headline);
    text-wrap: balance;
  }
  /* Bleeds past the reading column so it sets in three balanced lines. */
  .grants-hero__lede {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .grants-hero__lede { margin-inline: -3.5rem; }
  }
  .grants-hero__cta { margin-top: var(--spacing-3XL); }

  /* ── Layout: sticky index | one reading column ──────────────────────── */
  /* Index in the left gutter, a matching empty track on the right, so the
     reading column sits on the page's centre line under the hero. */
  .grants {
    display: grid;
    grid-template-columns: 170px minmax(0, var(--read-w)) 170px;
    justify-content: center;
    column-gap: var(--spacing-5XL);
    align-items: start;
    padding-block: var(--spacing-4XL) var(--spacing-max);
  }

  /* Sticky below the site header while it's showing (it slides back in on
     scroll-up), and up to the top while it's hidden — --index-top is set by
     the script from the header's own [data-hidden] state. */
  .grants__index {
    position: sticky;
    top: calc(var(--index-top, 0px) + var(--spacing-3XL));
    padding-top: 6px;
    transition: top 0.3s ease; /* in step with the header's 0.3s slide */
  }
  .grants__index-label {
    margin: 0 0 var(--spacing-L);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .grants__index ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent); }
  .grants__index a {
    position: relative;
    display: block;
    padding: 5px 0 5px var(--spacing-L);
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-subtle);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .grants__index a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: var(--text-headline);
    transform: scaleY(0);
    transition: transform 0.25s ease;
  }
  .grants__index a:hover { color: var(--text-headline); }
  .grants__index a[aria-current] { color: var(--text-headline); }
  .grants__index a[aria-current]::before { transform: scaleY(1); }

  /* ── Reading column: blog-prose scale (16px / 1.75) ─────────────────── */
  .grants__section {
    --h2-min: 22px;
    --h2-max: 26px;
    padding-top: var(--spacing-5XL);
    scroll-margin-top: var(--spacing-2XL);
  }
  .grants__section--open { padding-top: 0; }
  .grants__section h2 { margin: 0 0 var(--spacing-2XL); }
  .grants__section p,
  .grants__section li,
  .provisions dd { font-size: 16px; line-height: 1.75; }
  .grants__section p { margin: 0; }
  .grants__section p + p { margin-top: var(--spacing-L); }
  .grants__lead { color: var(--text-headline); }

  /* Current call: one status line (label · deadline) over the call's name —
     the masthead of everything below it, down to the call FAQ. */
  .call-head { margin-bottom: var(--spacing-4XL); }
  .call-head__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6em;
    margin: 0 0 var(--spacing-M) !important;
    font-size: 12px !important;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.6 !important;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .call-head__label i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-green-600); }
  .call-head__sep { opacity: 0.6; }
  .grants__section .call-head__title { --h2-min: 28px; --h2-max: 36px; margin: 0; text-wrap: balance; }

  /* What you'd do: the 12-week arc, set between two paragraphs */
  .provisions.provisions--arc { margin-block: var(--spacing-L) var(--spacing-2XL); }
  .grants__section strong { font-weight: 600; color: var(--text-headline); }

  /* What we provide: term | description, hairline rows */
  .provisions { margin: 0; }
  .provisions__row {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    column-gap: var(--spacing-2XL);
    padding-block: var(--spacing-L);
    border-top: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent);
  }
  .provisions__row:last-child { border-bottom: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent); }
  .provisions dt {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-headline);
  }
  .provisions dd { margin: 0; }

  /* How to apply / future calls: one quiet card — the dates, the form */
  .apply-card {
    margin-top: var(--spacing-3XL);
    padding: var(--spacing-3XL);
    border-radius: var(--border-radius-M);
    /* A faint ink tint of the page: a touch darker than the page in light
       (the white fields lift off it) and a touch lighter in dark (the dark
       fields sink into it) — separation in both themes. */
    background-color: color-mix(in srgb, var(--text-headline) 4%, var(--surface-background-default));
    border: 1px solid color-mix(in srgb, var(--text-headline) 8%, transparent);
  }
  .apply-card__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--spacing-L) var(--spacing-2XL);
    margin: 0;
    padding-bottom: var(--spacing-2XL);
    border-bottom: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent);
  }
  .apply-card__meta dt { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-subtle); }
  .apply-card__meta dd { margin: 4px 0 0; font-size: 15px; line-height: 1.5; color: var(--text-headline); }
  .apply-card__form { margin-top: var(--spacing-2XL); }
  .apply-card__form--solo { margin-top: 0; }
  .apply-card__fine { margin-top: var(--spacing-L) !important; font-size: 13px !important; color: var(--text-subtle); }

  /* FAQ: hairline disclosures; the answer eases open where the browser can
     animate to auto height, and simply appears elsewhere. */
  .faq { border-top: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent); interpolate-size: allow-keywords; }
  .faq details { border-bottom: 1px solid color-mix(in srgb, var(--text-headline) 12%, transparent); }
  .faq summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-L);
    padding-block: var(--spacing-L);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-headline);
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover span { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  /* +/– drawn from two strokes; the vertical one folds away when open. */
  .faq summary i { position: relative; flex: none; width: 11px; height: 11px; }
  .faq summary i::before,
  .faq summary i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 11px;
