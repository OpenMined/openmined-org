---
/**
 * /blog/author/<author>/page/N — pages 2..N of an author archive. Page 1 lives
 * at /blog/author/<author> ([author].astro); these continuation pages carry the
 * same header (glyph + name + count + byline) and the next newest-first slice.
 * Real, indexable pages (no-JS pagination) that BlogPagination also fetches to
 * append cards on scroll. Mirrors the tag/locations continuation routes.
 */
import BlogListing from '@layouts/BlogListing.astro';
import PostCard from '@elements/PostCard.astro';
import BlogCategoryNav from '@elements/BlogCategoryNav.astro';
import BlogToolbar from '@components/sections/blog/BlogToolbar.astro';
import BlogPagination from '@elements/BlogPagination.astro';
import { getCollection, getEntry } from 'astro:content';
import { postSlug, pageCount, pageSlice, collectAuthors } from '@utils/posts';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const all = await getCollection('blog', ({ data }) => includeDrafts || !data.draft && !data.unlisted);

  const paths = [];
  for (const { id } of collectAuthors(all)) {
    const posts = all
      .filter((p) => p.data.authors.some((a) => a.id === id))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = pageCount(posts.length);
    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        params: { author: id, page: String(page) },
        props: { page, totalPages, count: posts.length, entries: pageSlice(posts, page) },
      });
    }
  }
  return paths;
}

const { author } = Astro.params;
const { page, totalPages, count, entries } = Astro.props;

const person = await getEntry('people', author!);
const name = person?.data.name ?? author;
const byline = person?.data.bio;

const NAV_ORDER = ['news', 'product', 'research', 'policy', 'stories', 'community', 'foundation'];
const allCats = await getCollection('categories');
const navCats = NAV_ORDER
  .map((id) => allCats.find((c) => c.id === id))
  .filter((c) => c !== undefined)
  .map((c) => ({ id: c.id, label: c.data.label }));

const cards = await Promise.all(
  entries.map(async (p) => {
    const cat = await getEntry(p.data.categories[0]);
    return {
      href: `/blog/${postSlug(p)}/`,
      title: p.data.title,
      date: p.data.date,
      category: { slug: cat.id, label: cat.data.label },
      cover: p.data.cover,
      coverAlt: p.data.coverAlt,
      cardText: p.data.cardText,
      draft: p.data.draft,
    };
  })
);
---

<BlogListing title={`${name} — Blog — page ${page} — OpenMined`} description={`Posts by ${name} on the OpenMined blog.`}>
  <section class="author-archive container content-top-rule">
    <BlogCategoryNav categories={navCats} />

    <BlogToolbar heading={name} count={count} icon="circle-user" byline={byline} scope={{ author }} />

    <div class="blog-grid">
      {cards.map((c) => (
        <PostCard
          href={c.href}
          title={c.title}
          date={c.date}
          category={c.category}
          cover={c.cover}
          coverAlt={c.coverAlt}
          cardText={c.cardText}
          draft={c.draft}
        />
      ))}
    </div>

    <BlogPagination base={`/blog/author/${author}`} currentPage={page} totalPages={totalPages} />
  </section>
</BlogListing>

<style>
  .author-archive {
    padding-top: var(--spacing-3XL);
    padding-bottom: var(--spacing-full);
  }
  .author-archive :global(.category-nav) { margin-bottom: var(--spacing-3XL); }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--spacing-XL);
    row-gap: var(--spacing-2XL);
  }
  @media (max-width: 1099px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 767px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>
