{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ui/*":         ["src/components/ui/*"],
      "@elements/*":   ["src/components/elements/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*":    ["src/layouts/*"],
      "@styles/*":     ["src/styles/*"],
      "@assets/*":     ["src/assets/*"],
      "@data/*":       ["src/data/*"],
      "@utils/*":      ["src/utils/*"]
    }
  }
}
