---
/**
 * ResearchThemes — the /research/ themes "ledger": one outlined card whose
 * hairline-divided rows carry the five research themes (name | framing
 * question), closing on a dark footer row with the program's autonomy
 * statement. The same structural device as HomeFederatedNetwork (bordered
 * card → hairline rows → dark closing row), chosen over a card grid because
 * the themes are one set, not five products — the ledger reads as an agenda.
 *
 * The footer row must CONTRAST with the page in both themes, so it takes the
 * invert treatment (AGENTS.md → Color modes): background set directly to
 * `--dark-surface-background-default` (dark in light mode, light in dark
 * mode) with `data-section="invert"` remapping the text tokens to match. A
 * fixed `always-dark` row would vanish in dark mode — grayscale-850 is
 * exactly what the page background becomes there.
 */
interface Theme {
  title: string;
  question: string;
}
interface Props {
  themes: Theme[];
  /** The closing statement (verbatim program copy). */
  footnote: string;
}
const { themes, footnote } = Astro.props;
---

<div class="themes-ledger">
  {themes.map((t) => (
    <div class="themes-ledger__row">
      <h5>{t.title}</h5>
      <p>{t.question}</p>
    </div>
  ))}
  <div class="themes-ledger__foot" data-section="invert">
    <p>{footnote}</p>
  </div>
</div>

<style>
  .themes-ledger {
    border: var(--border-strong);
    border-radius: var(--border-radius-S);
    overflow: hidden; /* clips the dark footer to the card radius */
  }
  .themes-ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--spacing-L) var(--spacing-4XL);
    padding: var(--spacing-2XL) var(--spacing-3XL);
  }
  .themes-ledger__row + .themes-ledger__row {
    border-top: var(--border-subtle);
  }
  .themes-ledger__row h5 {
    margin: 0;
    text-wrap: balance;
  }
  .themes-ledger__row p {
    margin: 0;
    text-wrap: pretty;
  }
  .themes-ledger__foot {
    background-color: var(--dark-surface-background-default);
    padding: var(--spacing-2XL) var(--spacing-3XL);
  }
  .themes-ledger__foot p {
    margin: 0;
    color: var(--text-body);
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .themes-ledger__row { grid-template-columns: 1fr; gap: var(--spacing-S); }
    .themes-ledger__row,
    .themes-ledger__foot { padding: var(--spacing-XL) var(--spacing-2XL); }
  }
</style>
