        <div class="sg-group" id="cdn-icons">
          <h3 class="sg-group-heading">Ionicons — CDN, opt-in</h3>
          <p class="sg-section__desc">
            Loaded only on pages that set the <code>ionicons</code> prop (see <code>Base.astro</code>) —
            reserved for novel one-off glyphs not worth hosting. Sample below; the full library is at
            <code>ionic.io/ionicons</code>. Usage: <code>&lt;ion-icon name="arrow-forward-outline"&gt;&lt;/ion-icon&gt;</code>
          </p>
          <div class="sg-icon-grid">
            {icons.map(name => (
              <div class="sg-icon-cell">
