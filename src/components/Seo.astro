---
/**
 * Seo — the single owner of the document's SEO + social head tags.
 *
 * Mounted once from Base.astro's <head>. Emits <title>, description, canonical,
 * robots, Open Graph, and Twitter Card tags (+ article:* when type="article").
 * Every page reaches this through Base, so per-page SEO is just props on the
 * page's layout (Page / BlogPost) — see those layouts for the pass-through.
 *
 * The only logic here is (a) composing the final <title> from the page title +
 * site name and (b) absolutizing the canonical + image URLs against `site`
 * (astro.config.mjs → site). Callers pass a page-relative image path (e.g. a
 * blog cover's build URL); Seo resolves it to an absolute URL for OG/Twitter.
 *
 * Modeled on the live site's head (verified against openmined.org: 2026-07-15).
 */
import { SITE_NAME, SITE_URL, DEFAULT_DESCRIPTION, DEFAULT_OG_IMAGE, composeTitle } from '@data/site.mjs';
import { SITE_INDEXABLE, BUILD_BRANCH } from '@data/indexing.mjs';
import type { SchemaAuthor } from '@utils/schema';

interface Props {
  /** Raw page title (no site suffix) — Seo appends " — OpenMined" when needed. */
  title?: string;
  description?: string;
  /**
   * og:description / twitter:description override, for when the social blurb
   * should differ from (or exist without) the meta description. Blog posts use
   * it to carry a first-paragraph excerpt while shipping no meta description at
   * all — see the `type === 'article'` rule below.
   */
  socialDescription?: string;
  /** Page-relative or absolute image; absolutized against site for OG/Twitter. */
  image?: string;
  imageAlt?: string;
  /** Canonical / og:url path — defaults to the current route. */
  canonicalPath?: string;
  type?: 'website' | 'article';
  /**
   * Keep the page out of search indexes. Defaults TRUE — a deliberate
   * pre-launch guard so the in-progress migration is never indexed. AT LAUNCH:
   * flip the default in Base.astro's Props to false (one switch, whole site).
   */
  noindex?: boolean;
  /** article:* metadata — emitted only when type="article". */
  publishedTime?: string;
  modifiedTime?: string;
  /** Post authors. Only `.name` is used here; the rest feeds JsonLd.astro. */
  authors?: SchemaAuthor[];
  section?: string;
  tags?: string[];
}

const {
  title,
  description,
  socialDescription,
  image,
  imageAlt = '',
  canonicalPath,
  type = 'website',
  noindex = !SITE_INDEXABLE,
  publishedTime,
  modifiedTime,
  authors = [],
  section,
  tags = [],
} = Astro.props;

// Final <title> — the brand-suffix rule lives in @data/site.mjs → composeTitle,
// because JsonLd.astro needs the identical string for the graph's WebPage.name.
const fullTitle = composeTitle(title);

// `Astro.site` is set from astro.config.mjs → site; fall back to the constant so
// this never throws if the config value is ever unset.
const base = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base).href;
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, base).href;

/**
 * Meta description — and the one rule worth reading before changing it.
 *
 * A page that sets no description falls back to DEFAULT_DESCRIPTION, EXCEPT
 * when type="article". Live's posts ship **no** `<meta name="description">` at
 * all (verified against openmined.org: 2026-08-12), letting Google compose the
 * snippet from the matched passage. Falling back here instead would put ONE
 * identical boilerplate string on ~340 posts — measurably worse than absent,
 * because duplicate descriptions are ignored *and* they suppress the
 * query-relevant snippet Google would otherwise write.
 *
 * The rule keys off `type` rather than a separate flag so it cannot be
 * forgotten by a future post-like route: article ⇒ no invented description.
 */
const metaDescription =
  description?.trim() || (type === 'article' ? undefined : DEFAULT_DESCRIPTION);

/**
 * OG/Twitter descriptions are NOT subject to that rule — live's posts do carry
 * an og:description (a first-paragraph excerpt), and an empty social card is a
 * real regression where an absent meta description is not. Posts pass the
 * excerpt as `socialDescription`.
 *
 * `||`, NOT `??`, in both chains above and below — and that is load-bearing.
 * `??` falls through on null/undefined only, so an EMPTY string counts as a
 * supplied value: a post whose body yields no derivable excerpt passes '' and
 * shipped `<meta property="og:description" content>` with nothing in it (caught
 * on 5 posts, 2026-08-12). Empty must mean absent here.
 */
const socialDesc = socialDescription?.trim() || description?.trim() || DEFAULT_DESCRIPTION;
---
<title>{fullTitle}</title>
{metaDescription && <meta name="description" content={metaDescription} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
{/*
  Which branch built this, on non-indexable builds only — so it never reaches
  production, where it would be pure noise. It exists because the branch gate in
  @data/indexing.mjs depends on Amplify populating AWS_BRANCH, and this is the
  only way to confirm that from outside the build (no AWS console access). If a
  staging or preview page shows no build-branch meta, the variable is missing and
  the gate is running on its fail-closed path.
*/}
{!SITE_INDEXABLE && BUILD_BRANCH && <meta name="x-build-branch" content={BUILD_BRANCH} />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={socialDesc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={socialDesc} />
<meta name="twitter:image" content={ogImage} />

{type === 'article' && (
  <>
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {authors.map((a) => <meta property="article:author" content={a.name} />)}
    {section && <meta property="article:section" content={section} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </>
)}
