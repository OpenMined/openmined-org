import Page from '@layouts/Page.astro';
import EventRegLanding from '@components/sections/forms/EventRegLanding.astro';

const details = [
  { icon: 'calendar', html: 'Tuesday 17 February 2026, 1:30–5:00 PM IST' },
  { icon: 'map-pin', bold: true, html: '<a href="https://maps.app.goo.gl/6e56Wj2nrsRKuSTr5">India International Centre</a>, Conference Room II, New Delhi' },
