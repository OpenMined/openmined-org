      <!-- LOGOS -->
      <section class="sg-section" id="logos">
        <h2 class="sg-section__title">Logos</h2>
        <p class="sg-section__desc">All approved logo variants. SVG source files in <code>public/logos/</code>.</p>

        <h3 class="sg-subsection-title"><code>&lt;Logo /&gt;</code> — theme-aware component</h3>
        <p class="sg-section__desc">
          Swaps full-color ↔ white-on-dark with the page theme via the
          <code>.logo-color</code>/<code>.logo-white</code> convention in <code>global.css</code>.
        </p>
