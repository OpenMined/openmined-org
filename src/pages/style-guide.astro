      <!-- SECTIONS -->
      <section class="sg-section" id="sections">
        <h2 class="sg-section__title">Sections</h2>
        <p class="sg-section__desc">
          <code>&lt;CtaSection /&gt;</code> — reusable call-to-action band. Always renders a
          form via the required <code>form</code> slot; <code>heading</code>/<code>body</code> are
          props and copy varies per placement. <code>variant</code> is
          <code>gradient</code> (shown), <code>dark</code>, or <code>invert</code>. The card
          follows the page theme — toggle above to check light/dark. Other full-bleed
          sections (Partnerships, Press Room) are reviewed on-page, not here.
          The form is the <strong>live HubSpot embed</strong> (home newsletter,
          <code>b7a08fdc</code>) rendered via <code>@elements/FormEmbed</code> — it
          exercises the full <code>.hs-form</code> skin (text/email inputs, textarea,
          checkboxes, submit) and is the canonical surface for tuning that skin.
        </p>
        <div class="sg-bleed">
          <CtaSection
            heading="Take Control of Your Data's Future"
            body="Join the OpenMined community to stay informed, get involved, and shape how privacy and AI evolve together."
          >
            <FormEmbed slot="form" formId="b7a08fdc-0fb5-4938-99e8-4a09e7bbc09e" />
            <Fragment slot="fineprint">
              <p>Joining subscribes you to the <em>OpenMined Newsletter</em> and confirms you agree with our <a href="/privacy-policy/">privacy policy</a>.</p>
              <p><a href="/get-involved/">Explore ways to get involved ↗</a></p>
            </Fragment>
          </CtaSection>
        </div>
      </section>


      <!-- DONATE MODAL -->
      <section class="sg-section" id="donate">
        <h2 class="sg-section__title">Donate Modal</h2>
        <p class="sg-section__desc">
          <code>&lt;DonateModal /&gt;</code> — the site-wide "Secure Donation" dialog,
          mounted once globally in <code>Base.astro</code> and opened by any
          <code>[data-donate-open]</code> trigger (header nav, hero/foundation/footer
          Donate buttons, the get-involved card). A native <code>&lt;dialog&gt;</code>
          (top-layer, <code>::backdrop</code>, Esc-to-close). It stays the light
          "dim panel" treatment in both themes (<code>data-section="always-light"</code>),
          faithful to live. Submit POSTs to <code>/api/create-donation</code> (the
          site's one on-demand API route) which creates a Stripe Checkout Session and
          redirects; dormant until <code>STRIPE_SECRET_KEY</code> is set. Open it to
          check tabs, presets, custom amount, and the currency symbol swap.
        </p>
        <Button data-donate-open>Open donation dialog</Button>
      </section>


      <!-- SEARCH MODAL -->
      <section class="sg-section" id="search">
        <h2 class="sg-section__title">Search Modal</h2>
        <p class="sg-section__desc">
          <code>&lt;SearchModal /&gt;</code> — the site-wide full-screen search dialog,
          mounted once globally in <code>Base.astro</code> and opened by any
          <code>[data-search-open]</code> trigger (the header carries two: one in the
          desktop nav between the links and the social icons, one in the mobile bar
          beside the burger). Rebuilt from live's <code>.bricks-search-overlay</code>:
          a full-viewport scrim, one centered field with the magnifier inside its
          leading edge, and a large close glyph in the corner. Live renders a "Search
          site" title above the field but hides it, so there is deliberately no
          heading. A native <code>&lt;dialog&gt;</code>, so it paints over the sticky
          header from the top layer with no <code>z-index</code> at all. Enter is a
          plain GET to <a href="/search/">/search/</a> — no JS handler; the script
          only blocks a blank query and clears the field on open. Open it to check the
          scrim in both themes, the focus ring, and the close-glyph inset at mobile.
        </p>
        <Button data-search-open>Open search dialog</Button>
      </section>


      <!-- FOOTER -->
      <section class="sg-section" id="footer">
        <h2 class="sg-section__title">Footer</h2>
        <p class="sg-section__desc">
          <code>&lt;Footer /&gt;</code> is mounted as the default <code>footer</code> slot in
          <code>layouts/Page.astro</code> — it renders at the bottom of this page.
          Scroll down to inspect light/dark and desktop/mobile in context.
          Override per-page via <code>&lt;CustomFooter slot="footer" /&gt;</code>.
        </p>
      </section>

    </main>
  </div>
</Page>

<style>
  /* ── Layout ── */
  .sg-layout {
    display: flex;
    min-height: 100vh;
    align-items: flex-start;
  }

  .sg-sidebar {
    position: sticky;
    top: 0;
    width: 220px;
    flex-shrink: 0;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--surface-foreground-default);
    background: var(--surface-background-subtle, var(--surface-background-dim));
  }

  .sg-sidebar__inner {
    padding: var(--spacing-L);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-L);
  }

  .sg-nav__heading {
    color: var(--text-subtle);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sg-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sg-nav a {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-body);
    text-decoration: none;
    padding: 5px var(--spacing-S);
    border-radius: var(--border-radius-XS);
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  .sg-nav a:hover {
    background: var(--surface-foreground-low);
    color: var(--text-headline);
  }

  /* ── Main ── */
  .sg-main {
    flex: 1;
    min-width: 0;
    padding: var(--spacing-3XL);
  }

  /* Let a full-bleed section specimen break out of the main padding so it
     renders edge-to-edge (as it would on a real page). */
  .sg-bleed {
    margin-inline: calc(-1 * var(--spacing-3XL));
  }

  .sg-header {
    margin-bottom: var(--spacing-4XL);
    padding-bottom: var(--spacing-2XL);
    border-bottom: 1px solid var(--surface-foreground-default);
  }

  .sg-header h1 { margin-bottom: var(--spacing-M); }

  /* ── Section ── */
  .sg-section {
    margin-bottom: var(--spacing-4XL);
    padding-bottom: var(--spacing-4XL);
    border-bottom: 1px solid var(--surface-foreground-default);
  }

  .sg-section__title {
    margin-bottom: var(--spacing-2XL);
    font-size: 24px;
    color: var(--text-headline);
  }

  .sg-section__desc {
    color: var(--text-body);
    margin-bottom: var(--spacing-2XL);
  }

  .sg-subsection-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-subtle);
    margin-bottom: var(--spacing-L);
    font-family: var(--font-primary);
  }

  /* ── Colors ── */
  .sg-color-family { margin-bottom: var(--spacing-3XL); }

  .sg-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-XS);
  }

  .sg-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .sg-swatch__color {
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-XS);
    border: 1px solid var(--surface-foreground-default);
  }

  .sg-swatch__color--sm {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 3px;
  }

  .sg-swatch__label { font-size: 10px; color: var(--text-subtle); }

  .sg-token-table { display: flex; flex-direction: column; gap: var(--spacing-S); }
  .sg-token-row { display: flex; align-items: center; gap: var(--spacing-M); }

  /* ── Gradients ── */
  .sg-gradients { display: flex; flex-direction: column; gap: var(--spacing-L); }
  .sg-gradient-row { display: flex; align-items: center; gap: var(--spacing-L); }

  .sg-gradient-strip {
    width: 340px;
    height: 44px;
    border-radius: var(--border-radius-S);
    flex-shrink: 0;
  }

  .sg-gradient-meta { display: flex; flex-direction: column; gap: 4px; }
  .sg-gradient-label { font-size: 13px; color: var(--text-body); }

  /* ── Surfaces ── */
  .sg-surface-wrap {
    padding: var(--spacing-L);
    border-radius: var(--border-radius-M);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-M);
  }

  .sg-surface-grid {
    display: grid;
    gap: var(--spacing-M);
  }

  .sg-surface-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .sg-surface-grid--5 { grid-template-columns: repeat(5, 1fr); }

  .sg-surface-cell {
    padding: var(--spacing-L);
    border-radius: var(--border-radius-S);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-XS);
  }

  .sg-surface-cell code { font-size: 10px; word-break: break-all; background: none; padding: 0; }
  .sg-surface-cell span { font-size: 11px; color: var(--text-body); }

  /* ── Typography ── */
  .sg-type-specimens { display: flex; flex-direction: column; gap: 0; }

  .sg-type-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2XL);
    padding: var(--spacing-M) 0;
    border-bottom: 1px solid var(--surface-foreground-lowest);
  }

  .sg-type-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-subtle);
    min-width: 180px;
    flex-shrink: 0;
    font-family: var(--font-primary);
  }

  .sg-type-demo { margin: 0; }

  .sg-article-demo {
    border: 1px solid var(--surface-foreground-default);
    border-radius: var(--border-radius-M);
    padding: var(--spacing-4XL);
  }

  /* ── Responsive scale table ── */
  .sg-scale-table {
    border: var(--border-subtle);
    border-radius: var(--border-radius-S);
    overflow: hidden;
  }

  .sg-scale-row {
    display: grid;
    grid-template-columns: 48px repeat(4, 1fr);
    gap: var(--spacing-L);
    padding: var(--spacing-M) var(--spacing-L);
    border-bottom: 1px solid var(--surface-foreground-lowest);
    font-size: 13px;
    color: var(--text-body);
    align-items: center;
  }

  .sg-scale-row:last-child { border-bottom: none; }

  .sg-scale-row--head {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    background: var(--surface-foreground-lowest);
  }

  .sg-scale-row code { font-size: 12px; }

  /* ── .measure demos ── */
  .sg-measure-demos {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2XL);
  }

  .sg-measure-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-XS);
  }

  .sg-measure-text {
    background: var(--surface-foreground-lowest);
    padding: var(--spacing-L);
    border-radius: var(--border-radius-S);
    margin: 0;
  }

  .sg-article-img-placeholder {
    width: 100%;
    aspect-ratio: 16 / 7;
    background: var(--surface-foreground-low);
    border-radius: var(--border-radius-S);
  }

  /* Prose specimen — dashed frame marks the .prose container bounds so the
     content / wide / full zones are legible.

     `overflow-x: clip` is the same backstop `article.post` carries, and it is
     needed for the same reason: `.breakout--full` sizes itself to the VIEWPORT
     (`min(--container-full, 100vw - gutters)`) and overflows its grid track to
     get edge-to-edge. In a real post that track is centred in the page, so the
     overflow is symmetric and lands in the gutters; here the specimen sits in the
     narrower main column beside `.sg-sidebar`, so the same block ran up to 132px
     past the right edge and made the style guide itself scroll sideways at every
     width. Clipping keeps the specimen honest about its own container instead. */
  .sg-prose-frame {
    border: 1px dashed var(--surface-foreground-default);
    border-radius: var(--border-radius-S);
    padding-block: var(--spacing-2XL);
    /* The frame stands in for the page shell here, so it owns the gutter —
       `.prose-article` no longer carries one of its own. */
    padding-inline: var(--spacing-XL);
    overflow-x: clip;
  }
  .sg-prose-fullblock {
    background: var(--color-teal-400);
    color: #fff;
    text-align: center;
    padding: var(--spacing-L);
    border-radius: var(--border-radius-S);
    font-family: monospace;
    font-size: 14px;
  }

  /* ── Spacing ── */
  .sg-spacing-list { display: flex; flex-direction: column; gap: var(--spacing-S); }

  .sg-spacing-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-L);
  }

  .sg-spacing-label { font-size: 12px; min-width: 160px; }
  .sg-spacing-name { font-size: 11px; color: var(--text-subtle); }

  /* ── Border Radius ── */
  .sg-radius-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2XL);
    align-items: flex-end;
  }

  .sg-radius-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-S);
  }

  .sg-radius-box {
    width: 72px;
    height: 72px;
    background: var(--surface-foreground-low);
    border: 2px solid var(--surface-foreground-high);
  }

  .sg-radius-cell code, .sg-radius-cell span { font-size: 11px; color: var(--text-subtle); text-align: center; }

  /* ── Outlines ── */
  .sg-outline-grid { display: flex; gap: var(--spacing-3XL); flex-wrap: wrap; align-items: flex-start; }

  .sg-outline-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-S);
    max-width: 200px;
  }

  .sg-outline-box {
    width: 160px;
    height: 72px;
    border-radius: var(--border-radius-S);
  }

  .sg-outline-cell code, .sg-outline-cell span { font-size: 11px; color: var(--text-subtle); text-align: center; }

  /* ── Shadows ── */
  .sg-shadow-grid { display: flex; gap: var(--spacing-3XL); flex-wrap: wrap; }

  .sg-shadow-cell {
    width: 160px;
    height: 100px;
    background: var(--surface-background-dim, var(--surface-foreground-lowest));
    border-radius: var(--border-radius-M);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-XS);
  }

  .sg-shadow-cell code, .sg-shadow-cell span { font-size: 11px; color: var(--text-body); }

  /* ── Card float ──
     Bare specimen boxes: `.card-float` supplies the whole hover, so the only
     thing declared per-cell is the resting shadow VAR (never box-shadow) and
     enough surface to see it against. */
  .sg-cardfloat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--spacing-2XL);
    /* the raised cell's shadow needs room to grow into */
    padding-block: var(--spacing-S) var(--spacing-2XL);
  }
  .sg-cardfloat {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-XS);
    min-height: 130px;
    padding: var(--spacing-2XL);
    border-radius: var(--border-radius-S);
    background-color: var(--surface-background-bright);
    color: var(--text-body);
    text-decoration: none;
  }
  .sg-cardfloat--raised {
    --card-float-shadow: var(--shadow-md);
    --card-float-shadow-hover: var(--shadow-lg);
  }
  .sg-cardfloat--static { opacity: 0.75; }
  .sg-cardfloat strong { color: var(--text-headline); }
  .sg-cardfloat span { font-size: 12px; }
  .sg-cardfloat__note { color: var(--text-subtle); }

  /* ── Transitions ── */
  .sg-transition-grid { display: flex; gap: var(--spacing-2XL); flex-wrap: wrap; align-items: flex-start; }

  .sg-transition-cell {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-S);
    max-width: 240px;
  }

  .sg-transition-box {
    width: 160px;
    height: 72px;
    background: var(--surface-foreground-low);
    border-radius: var(--border-radius-S);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    cursor: default;
    border: 1px solid var(--surface-foreground-default);
  }

  .sg-transition-box:hover { background: var(--color-teal-100); }
  :global([data-theme="dark"]) .sg-transition-box:hover { background: var(--color-teal-900); }

  .sg-transition-cell code { font-size: 12px; }
