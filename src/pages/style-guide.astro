// Every locally hosted icon (src/assets/icons/*.svg), auto-enumerated so this
// specimen stays complete as the set grows — no manual list to maintain.
// Rendered via @elements/Icon; the same glob backs Icon.astro's own lookup.
const hostedIcons = Object.keys(import.meta.glob('../assets/icons/*.svg'))
  .map((path) => path.split('/').pop()!.replace('.svg', ''))
  .sort();

// Categorized by ROLE / provenance, not theme — three groups:
//   • Interface — glyphs wired into a control (nav, disclosure, toolbar, copy).
//     Fixed jobs; repurpose with care.
//   • Brand logos — external third-party marks (social + tech), prefixed `logo-`.
//   • Content — the a-la-carte editorial set dropped into page bodies as needed.
// Interface + Brand logos are explicit lists (filtered to real files so a stale
// entry can't throw); Content is the computed remainder, so any NEWLY added icon
// defaults into Content until it's promoted — the grid never drops an icon.
const hostedSet = new Set(hostedIcons);
const interfaceIcons = [
  'menu', 'close', 'chevron-down', 'search', 'copy', 'checkmark', 'filter', 'sort',
].filter((n) => hostedSet.has(n));
const brandLogos = [
  'logo-github', 'logo-x', 'logo-linkedin', 'logo-youtube', 'logo-bluesky',
  'logo-python', 'logo-node', 'logo-flower',
].filter((n) => hostedSet.has(n));
const roleBound = new Set([...interfaceIcons, ...brandLogos]);
const contentIcons = hostedIcons.filter((n) => !roleBound.has(n));

const iconGroups = [
  {
    name: 'Interface',
    desc: 'Glyphs wired into a control — nav / burger, disclosure carets, the code-copy button, the (deferred) blog toolbar. These have a fixed job.',
    names: interfaceIcons,
  },
  {
    name: 'Content',
    desc: 'The a-la-carte editorial set — dropped into page bodies wherever a concept needs a mark. Includes the colored comparison pair check-solid (green) / x-solid (red); everything else takes currentColor. New icons land here by default.',
    names: contentIcons,
  },
  {
    name: 'Brand logos',
    desc: 'External third-party marks (social platforms + tech), prefixed `logo-` to signal “not our glyph.” logo-x is the X (Twitter) logo — distinct from the close and x-solid glyphs.',
    names: brandLogos,
  },
];

// Ionicons (CDN, opt-in) — a small illustrative sample of the novel one-off
// glyphs available on pages that set the `ionicons` prop (see Base.astro).
const icons = [
  'logo-github', 'logo-twitter', 'logo-linkedin', 'logo-youtube',
  'arrow-forward-outline', 'arrow-back-outline', 'chevron-forward-outline', 'chevron-down-outline',
  'close-outline', 'menu-outline', 'search-outline', 'moon-outline', 'sunny-outline',
  'copy-outline', 'link-outline', 'open-outline', 'download-outline',
  'checkmark-circle-outline', 'alert-circle-outline', 'information-circle-outline',
  'lock-closed-outline', 'shield-checkmark-outline', 'eye-outline', 'layers-outline',
];

const selectOptions = [
  { value: 'opt1', label: 'Option 1' },
  { value: 'opt2', label: 'Option 2' },
  { value: 'opt3', label: 'Option 3' },
];

const logoGroups = [
  {
    group: 'Horizontal',
    logos: [
      { file: 'OpenMined-Logo.svg',           label: 'Full color',  dark: false },
      { file: 'OpenMined-Logo-Dark.svg',       label: 'Reversed',    dark: true  },
      { file: 'OpenMined-Logo-Ghost.svg',      label: 'Ghost',       dark: true  },
      { file: 'OpenMined-Logo-Mono-White.svg', label: 'Mono white',  dark: true  },
      { file: 'OpenMined-Logo-Mono-Black.svg', label: 'Mono black',  dark: false },
    ],
  },
  {
    group: 'Stacked',
    logos: [
      { file: 'OpenMined-Logo-Stacked.svg',           label: 'Full color', dark: false },
      { file: 'OpenMined-Logo-Stacked-Dark.svg',       label: 'Reversed',   dark: true  },
      { file: 'OpenMined-Logo-Stacked-Ghost.svg',      label: 'Ghost',      dark: true  },
      { file: 'OpenMined-Logo-Stacked-Mono-White.svg', label: 'Mono white', dark: true  },
      { file: 'OpenMined-Logo-Stacked-Mono-Black.svg', label: 'Mono black', dark: false },
