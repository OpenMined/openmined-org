          <DiamondEmbed id="diamond-sg" labelLeft="Non-Public Data" labelRight="Attributable Insights" />
        </div>

        <h3 class="sg-subsection-title" style="margin-top: var(--spacing-3XL);">Stream Embed (Gradient WebGL)</h3>
