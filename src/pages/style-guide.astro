            <a href="#card-hover" class="sg-cardfloat sg-cardfloat--raised card-float">
              <strong>Raised card</strong>
              <span><code>--shadow-md</code> &rarr; <code>--shadow-lg</code></span>
              <span class="sg-cardfloat__note">rests with a shadow already (LogoCard / Press Room)</span>
            </a>
            <div class="sg-cardfloat sg-cardfloat--static">
              <strong>Not a link</strong>
