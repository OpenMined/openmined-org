{
  // workerd runtime config for `astro dev` — the Cloudflare adapter's
  // platformProxy reads it. (At build the adapter also augments it into
  // dist/server/wrangler.json, an artifact the AWS deploy does not use.)
  //
  // nodejs_compat + a recent compatibility_date give the workerd dev runtime
  // the Node globals our render path expects (notably `process`). node:fs is
  // NOT provided (workerd has no filesystem) — build-time file reads go through
  // the Vite bundler instead (see OrgLogo.astro, Icon.astro).
  "name": "openmined-org",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"]
}
